<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrestaLibros.LibrosPage"
             Title="Registrar Libro"
             BackgroundColor="#f4f6f8">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- Título Principal -->
            <Label Text="📖 Registrar Nuevo Libro" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="#2c3e50" 
                   HorizontalOptions="Center"
                   Margin="0,0,0,5"/>

            <!-- Tarjeta contenedora con esquinas redondeadas -->
            <Border BackgroundColor="White" 
                    StrokeShape="RoundRectangle 16" 
                    StrokeThickness="0" 
                    Padding="20">
                <VerticalStackLayout Spacing="12">

                    <Label Text="ISBN:" FontSize="13" FontAttributes="Bold" TextColor="#34495e"/>
                    <Entry x:Name="txtIsbn" Placeholder="Ej: 978-3-16-148410-0" BackgroundColor="#f8f9fa" HeightRequest="45"/>

                    <Label Text="Título:" FontSize="13" FontAttributes="Bold" TextColor="#34495e"/>
                    <Entry x:Name="txtTitulo" Placeholder="Título del libro" BackgroundColor="#f8f9fa" HeightRequest="45"/>

                    <Label Text="Autor:" FontSize="13" FontAttributes="Bold" TextColor="#34495e"/>
                    <Entry x:Name="txtAutor" Placeholder="Autor o autores" BackgroundColor="#f8f9fa" HeightRequest="45"/>

                    <Label Text="Editorial:" FontSize="13" FontAttributes="Bold" TextColor="#34495e"/>
                    <Entry x:Name="txtEditorial" Placeholder="Editorial" BackgroundColor="#f8f9fa" HeightRequest="45"/>

                    <Label Text="Año de Publicación:" FontSize="13" FontAttributes="Bold" TextColor="#34495e"/>
                    <Entry x:Name="txtAnio" Placeholder="Ej: 2023" Keyboard="Numeric" BackgroundColor="#f8f9fa" HeightRequest="45"/>

                    <Label Text="Ruta o URL Portada:" FontSize="13" FontAttributes="Bold" TextColor="#34495e"/>
                    <Entry x:Name="txtPortada" Placeholder="Opcional (ej: portada.jpg)" BackgroundColor="#f8f9fa" HeightRequest="45"/>

                    <Label Text="Stock Disponible:" FontSize="13" FontAttributes="Bold" TextColor="#34495e"/>
                    <Entry x:Name="txtStock" Placeholder="Ej: 5" Keyboard="Numeric" BackgroundColor="#f8f9fa" HeightRequest="45"/>

                </VerticalStackLayout>
            </Border>

            <!-- Botones de Acción -->
            <VerticalStackLayout Spacing="10" Margin="0,5,0,10">
                <Button Text="Guardar Libro" 
                        BackgroundColor="#2ecc71" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="guardarLibroClicked"/>

                <Button Text="Cancelar" 
                        BackgroundColor="#e0e0e0" 
                        TextColor="#2c3e50" 
                        FontAttributes="Bold" 
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="cancelarLibroClicked"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>